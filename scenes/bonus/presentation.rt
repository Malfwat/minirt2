# Vitrine : tout ce que le programme sait faire, en une image.
#
# Trois lumieres colorees et leurs ombres dures, speculaire de Phong avec
# exposant variable, damier sur les quatre formes (plan, sphere, cylindre,
# cone), anti-aliasing adaptatif, affichage progressif.
#
# Damiers : sol 1.6, sphere 0.55 en latitude-longitude, cylindre 0.50 en arc et
# hauteur (dix colonnes fermees sur le tour), cone 0.50 en angle et distance de
# pente, les cellules se resserrent vers le sommet. Le cone violet est incline
# de 30 degres pour montrer que le repere suit son axe.
#
# Les deux petites spheres restent unies : c'est la que le reflet speculaire se
# lit le mieux, un serre a 220, l'autre large a 30.
#
# Champs : <obj> position [axe] [diametre hauteur] couleur [intensite exposant]
# [taille damier].
A 0.22 200,214,255

C 0,1.6,-10.5 0,0.06,1 48

L -10,12,-6 1.00 255,190,130
L 12,7,-2 0.70 110,160,255
L 0,8,8 0.60 255,120,190

pl 0,0,0 0,1,0 128,132,148 0 0 1.6
pl 0,0,9.5 0,0,-1 58,62,78

sp -2.6,1.4,1.6 2.8 208,56,54 0.85 90 0.55
co 0.2,3.4,3.0 0,-1,0 1.9 3.4 240,200,88 0.80 90 0.50
cy 2.5,1.9,2.2 0,1,0 1.6 3.8 96,200,162 0.70 45 0.50
co 3.9,2.0,1.8 0.42,-0.86,0.28 1.1 2.0 150,120,235 0.45 40 0.40

sp 1.35,0.65,0.0 1.3 250,240,215 0.95 220
sp -1.05,0.55,-0.4 1.1 255,150,190 0.60 30
