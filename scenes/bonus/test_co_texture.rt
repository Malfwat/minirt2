# Cible de test : texture sur un CONE.
# Un cone de tole pose sur un sol pave, pour verifier l'enroulement et la
# convergence des texels vers le sommet.
# A lancer depuis la racine du depot :
#   ./miniRT_bonus scenes/bonus/test_co_texture.rt
A 0.18 170,185,215

C 0,2,-10 0,0,1 50

L 7,8,-5 1.0 255,250,235
L -7,3,3 0.35 165,195,255

pl 0,-2,0 0,1,0 255,255,255 0.10 30 0 assets/textures/paving_color.ppm assets/textures/paving_normal.ppm

co 0,-2,0 0,1,0 2.4 5 255,255,255 0.35 150 0 assets/textures/metalplates_color.ppm assets/textures/metalplates_normal.ppm
