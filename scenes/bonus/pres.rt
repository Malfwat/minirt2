# Vitrine : trois lumieres colorees, ombres dures, speculaire, damier sur les
# trois formes, anti-aliasing adaptatif et affichage progressif.
#
# Le sol porte un damier de 1.6, le cylindre un damier de 0.5 (dix colonnes
# autour du fut, donc un tour ferme), la sphere bleue un damier
# latitude-longitude de 0.55. La rouge et la jaune restent unies pour montrer
# le reflet speculaire sur une surface lisse.
#
# Champs : <obj> position ... couleur [intensite exposant] [taille damier].
A 0.16 180,200,255

C 0,0.55,-9 0,0.03,1 58

L -11,13,-7 0.90 255,186,126
L 13,6,-2 0.60 96,152,255
L 1,8,8 0.50 255,104,186

pl 0,-1.6,0 0,1,0 74,76,86 0 0 1.6
pl 0,0,9.5 0,0,-1 34,38,50

sp -3.0,-0.3,1.0 2.6 208,56,54 0.85 90
sp -1.15,-0.7,2.0 1.8 56,136,232 0.55 0 0.55
sp 2.9,-0.6,0.4 2.0 240,200,72 0.95 140
cy 1.05,0.55,5.2 0,1,0 1.7 4.2 96,200,162 0.7 45 0.5
